# BabyLink Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=production
PORT=3001

# WebRTC Configuration
# STUN server for NAT traversal
STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server for difficult network scenarios
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password

# Address advertised to ESP32-S3 devices during setup (mandatory in Docker,
# where the container only sees its bridge IP), and the port they use.
# PUBLIC_HOST=192.168.1.10
# PUBLIC_PORT=3001
# Base URL for links in push notifications (default: the request's host).
# PUBLIC_URL=https://babylink.example.org

# Room Configuration
MAX_ROOMS=1000
MAX_BABIES_PER_ROOM=5
MAX_PARENTS_PER_ROOM=10
ROOM_CLEANUP_INTERVAL=3600000  # 1 hour in milliseconds
ROOM_CONFIG_TTL_DAYS=90        # forget unused rooms without PIN/notifications

# Security Configuration
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=600
ROOM_CREATE_LIMIT=30      # room creations per IP per hour
MAX_SOCKETS_PER_IP=20

# Socket.IO heartbeat (ms) — how fast a vanished device is noticed
SOCKET_PING_INTERVAL=10000
SOCKET_PING_TIMEOUT=5000

# Logging Configuration
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_TO_FILE=false  # true writes to LOG_FILE_PATH as well as stdout
LOG_FILE_PATH=./logs/babylink.log

# CORS Configuration (optional, for specific origins)
# CORS_ORIGIN=https://yourdomain.com
# CORS_CREDENTIALS=true

# ntfy: extra allowed ntfy servers besides ntfy.sh (comma-separated hosts)
# NTFY_ALLOWED_HOSTS=ntfy.example.org

# Feature Flags
ENABLE_MULTI_BABY=true
